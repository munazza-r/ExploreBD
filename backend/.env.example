# Reuse the same ExploreBD MongoDB database used by Modules 1 and 2.
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster-url>/ExploreBD?retryWrites=true&w=majority

HOST=127.0.0.1
PORT=5073
FRONTEND_URL=http://127.0.0.1:5173

# Use long random secrets outside local development.
JWT_SECRET=replace_with_a_long_random_login_secret
QR_PASS_SECRET=replace_with_a_long_random_qr_pass_secret

# Optional if the local resolver refuses MongoDB Atlas SRV lookups.
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
