# Same shared MongoDB Atlas cluster used across the whole project.
# Prisma reads DATABASE_URL; Mongoose (used only for the User/auth system) reads MONGO_URI.
# Both should point at the SAME database.
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/ExploreBD?retryWrites=true&w=majority"
MONGO_URI="mongodb+srv://<username>:<password>@<cluster-url>/ExploreBD?retryWrites=true&w=majority"

PORT=5000

# Signs auth tokens - use a long random string in production
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Gmail SMTP for signup OTP emails (optional in dev - see EMAIL_MODE below)
GMAIL_USER=your.explorebd.sender@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password

# Set to "console" in local development to skip real emails - OTP is printed to the terminal instead
EMAIL_MODE=console
NODE_ENV=development

GOOGLE_MAPS_API_KEY= 
APPROVAL_WINDOW_MINUTES=10

GEMINI_API_KEY=

QR_PASS_SECRET=replace_with_another_long_random_secret