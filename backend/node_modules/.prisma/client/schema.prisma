datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String        @unique
  password      String
  role          String        @default("TOURIST") // "TOURIST" | "GUIDE" | "ADMIN"
  country       String?       @default("Bangladesh")
  nidOrPassport String?
  isVerified    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  guideProfile  GuideProfile?
}

model GuideProfile {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  userId           String        @unique @db.ObjectId
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio              String
  location         String        @default("Dhaka, Bangladesh")
  languages        String[]      @default(["Bengali", "English", "Hindi"])
  specialties      String[]      @default(["Sundarbans", "Bagerhat", "Cox's Bazar", "Bandarban", "Rangamati", "Sreemangal", "Old Dhaka", "River Cruises"])
  hourlyRate       Float         @default(650.0)
  platformFeeRate  Float         @default(12.0)
  toursDone        Int           @default(142)
  avgRating        Float         @default(4.9)
  repeatClientRate Int           @default(78)
  isPublic         Boolean       @default(true)
  isVerifiedGuide  Boolean       @default(true)
  isTopRated       Boolean       @default(true)
  availability     Availability?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Availability {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  guideProfileId String       @unique @db.ObjectId
  guideProfile   GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  availableDays  String[]     @default(["Friday", "Saturday", "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday"])
  startTime      String       @default("10:00 A.M")
  endTime        String       @default("06:00 P.M")
}
