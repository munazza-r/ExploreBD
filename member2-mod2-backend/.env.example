DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/ExploreBD?retryWrites=true&w=majority"
PORT=5062

# Optional: if set, real distances/times are calculated with Google's Distance Matrix + Geocoding APIs.
# If left blank, the app falls back to realistic mock route data (no API key needed to test).
GOOGLE_MAPS_API_KEY=

# How many minutes the guide has to approve suggested meeting points before
# the platform automatically falls back to their pre-configured fallback points.
APPROVAL_WINDOW_MINUTES=10