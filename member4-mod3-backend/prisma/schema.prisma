generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum RequestKind {
  CANCELLATION
  COMPENSATION_CLAIM
}

enum CancellationInitiator {
  TOURIST
  GUIDE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ResolutionType {
  REFUND
  REASSIGNMENT
}

enum ClaimCategory {
  NO_SHOW
  INCOMPLETE_TOUR
  SERVICE_QUALITY_ISSUE
  SAFETY_CONCERN
}

model CancellationRequest {
  id                  String                @id @default(auto()) @map("_id") @db.ObjectId
  requestKind         RequestKind
  bookingId           String
  initiatedBy         CancellationInitiator
  requesterId         String
  reason              String
  bookingDate         DateTime
  totalPrice          Float

  // Cancellation-specific
  resolutionType      ResolutionType?       // guide's choice: REFUND or REASSIGNMENT
  suggestedGuideId    String?
  suggestedGuideName  String?
  refundAmount        Float?
  compensationAmount  Float?                // penalty paid to guide on late tourist cancellation

  // Compensation-claim-specific
  category            ClaimCategory?
  claimAmount         Float?

  status              RequestStatus         @default(PENDING)
  policySnapshot      String?

  resolvedBy          String?
  resolvedAt          DateTime?

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@map("CancellationRequest")
}

model SosRequest {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  bookingId     String
  initiatedBy   String
  requesterId   String
  category      String
  contactNumber String
  claimDetails  String
  status        RequestStatus @default(PENDING)

  resolvedBy    String?
  resolvedAt    DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("SosRequest")
}