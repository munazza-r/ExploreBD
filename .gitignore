# ─── Nested / Other Repos ────────────────────────
# Local backups of Git metadata removed from formerly nested repositories.
# Keeping these out of the parent repository prevents modules from becoming
# submodules/gitlinks again while preserving their local history if needed.
.nested-git-backups/

# Runtime uploads are local data and should not be committed.
attachments/
