// Prisma schema for ExploreBD - Feature 1
// Location & Language-Based Smart Guide Matching

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Guide {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  location     String
  languages    String[] // e.g. ["English", "Bangla", "French"]
  rating       Float    @default(0)
  experience   Int      @default(0) // years
  budget       Int      // taka per hour
  availability String   @default("Available") // "Available" | "Busy"
  reviewCount  Int      @default(0)
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  imageUrl String?
}
