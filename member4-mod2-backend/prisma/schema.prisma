// Module 2 - Feature 4: Smart Itinerary Builder & AI Guide Recommendation System
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model ItineraryRequest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  destination String
  tripLength  Int
  budget      Int
  interests   String[]
  itinerary   Json
  guides      Json
  createdAt   DateTime @default(now())
}
