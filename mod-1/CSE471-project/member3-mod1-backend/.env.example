# ──────────────────────────────────────────────────────
# ExploreBD Backend Environment Variables
# Copy this file as .env and fill in your own values
# DO NOT commit the actual .env file to GitHub
# ──────────────────────────────────────────────────────

# MongoDB Atlas connection used by all three modules. DATABASE_URL is also accepted.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ExploreBD?retryWrites=true&w=majority

# Optional if the local ISP/system DNS refuses MongoDB Atlas SRV lookups.
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT Secret Key (use a long random string)
JWT_SECRET=your_jwt_secret_key_here

# Server Port
PORT=5053

# Node Environment
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5053

# Optional Gmail SMTP settings for re-enabling OTP verification later.
# Use a Google App Password, never your normal Gmail password.
GMAIL_USER=your.explorebd.sender@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password

# Not used by the current direct-signup form.
EMAIL_MODE=gmail

# Signs QR booking passes. Use at least 32 random characters outside development.
QR_PASS_SECRET=replace_with_a_long_random_secret_at_least_32_chars
